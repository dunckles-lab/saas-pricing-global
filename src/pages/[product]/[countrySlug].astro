---
import Layout from '../../layouts/Layout.astro';
import { SAAS_PRODUCTS, type SaaSProduct } from '../../data/products';
import { COUNTRIES, type CountryInfo } from '../../data/countries';
import { calculateNormalizedPrices, formatCurrencyLocal } from '../../utils/pricing';

export function getStaticPaths() {
  const paths = [];

  for (const product of SAAS_PRODUCTS) {
    for (const country of Object.values(COUNTRIES)) {
      const countrySlug = country.name.toLowerCase().replace(/\s+/g, '-');
      paths.push({
        params: {
          product: product.id,
          countrySlug: `price-in-${countrySlug}`,
        },
        props: { product, country },
      });
    }
  }

  return paths;
}

interface Props {
  product: SaaSProduct;
  country: CountryInfo;
}

const { product, country } = Astro.props;
const primaryPlan = product.plans[0];
const normalized = calculateNormalizedPrices(primaryPlan);
const currentItem = normalized.find((i) => i.country.code === country.code);
const usItem = normalized.find((i) => i.country.code === 'us') || normalized[normalized.length - 1];

const localPrice = currentItem ? currentItem.localPrice : 0;
const usdPrice = currentItem ? currentItem.usdPrice : 0;
const diffPercent = currentItem ? currentItem.differenceVsUSPercent : 0;

const title = `${product.name} Price in ${country.name} (${country.currency} Conversion & Cost 2026)`;
const description = `How much is ${product.name} in ${country.name}? Official local price is ${formatCurrencyLocal(localPrice, country.currency)} (~$${usdPrice.toFixed(2)} USD). See full pricing breakdown and savings vs US.`;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": `${product.name} Subscription in ${country.name}`,
  "description": description,
  "offers": {
    "@type": "Offer",
    "priceCurrency": country.currency,
    "price": localPrice,
    "priceValidUntil": "2026-12-31",
    "availability": "https://schema.org/InStock",
    "url": `https://saas-pricing-global.pages.dev/${product.id}/price-in-${country.name.toLowerCase().replace(/\s+/g, '-')}`
  }
};
---

<Layout title={title} description={description} canonicalPath={`/${product.id}/price-in-${country.name.toLowerCase().replace(/\s+/g, '-')}`} jsonLd={[productSchema]}>
  <div style="margin-bottom: 28px;">
    <div style="margin-bottom: 12px;">
      <a href={`/${product.id}/pricing`} style="font-size: 0.88rem; color: var(--text-dim); display: inline-flex; align-items: center; gap: 6px;">
        ← Back to {product.name} Global Matrix
      </a>
    </div>
    <div style="display: flex; gap: 10px; align-items: center; margin-bottom: 8px;">
      <span class="badge badge-category">{country.flag} {country.name}</span>
      <span style="font-size: 0.82rem; color: #38bdf8;">Verified Regional Pricing</span>
    </div>
    <h1 style="font-size: 2.5rem; font-weight: 800; color: #ffffff; letter-spacing: -0.5px; margin: 6px 0;">
      How Much is {product.name} in {country.name}?
    </h1>
    <p style="color: var(--text-muted); font-size: 1.05rem; max-width: 820px;">
      Complete breakdown of subscription pricing, currency conversion rates, and purchasing power parity for {country.name}.
    </p>
  </div>

  <!-- Main Hero Price Card -->
  <div class="glass-card" style="background: linear-gradient(135deg, rgba(14, 21, 38, 0.95), rgba(6, 9, 19, 0.95)); border: 1px solid var(--border-glass); border-left: 5px solid #38bdf8; margin-bottom: 28px;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px;">
      <div>
        <span style="color: var(--text-dim); font-size: 0.85rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">
          Official Local Price ({country.currency}):
        </span>
        <div class="mono" style="font-size: 2.8rem; font-weight: 800; color: #38bdf8; line-height: 1.1; margin: 8px 0;">
          {formatCurrencyLocal(localPrice, country.currency)} <span style="font-size: 1.1rem; color: var(--text-dim); font-weight: 400;">/ month</span>
        </div>
        <div style="font-size: 1.2rem; color: #f8fafc; font-weight: 600; display: flex; align-items: center; gap: 8px;">
          <span>≈</span>
          <span class="mono" style="color: #34d399; font-size: 1.4rem; font-weight: 800;">${usdPrice.toFixed(2)} USD</span>
          <span style="color: var(--text-dim); font-size: 0.85rem; font-weight: 400;">(live FX benchmark)</span>
        </div>
      </div>

      <div style="text-align: right;">
        {diffPercent < 0 ? (
          <div style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); padding: 14px 20px; border-radius: 12px;">
            <span style="font-size: 0.82rem; color: #a7f3d0; text-transform: uppercase; font-weight: 700;">Regional Savings</span>
            <div class="mono" style="font-size: 1.8rem; font-weight: 900; color: #34d399;">
              {Math.abs(diffPercent)}% OFF
            </div>
            <span style="font-size: 0.8rem; color: var(--text-dim);">vs United States (${usItem.usdPrice}/mo)</span>
          </div>
        ) : diffPercent > 0 ? (
          <div style="background: rgba(244, 63, 94, 0.1); border: 1px solid rgba(244, 63, 94, 0.3); padding: 14px 20px; border-radius: 12px;">
            <span style="font-size: 0.82rem; color: #fecdd3; text-transform: uppercase; font-weight: 700;">Price Premium</span>
            <div class="mono" style="font-size: 1.8rem; font-weight: 900; color: #fb7185;">
              +{diffPercent}% HIGHER
            </div>
            <span style="font-size: 0.8rem; color: var(--text-dim);">vs United States (${usItem.usdPrice}/mo)</span>
          </div>
        ) : (
          <div style="background: rgba(255, 255, 255, 0.05); padding: 14px 20px; border-radius: 12px;">
            <span style="font-size: 0.82rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;">Baseline Rate</span>
            <div class="mono" style="font-size: 1.5rem; font-weight: 700; color: #ffffff;">Standard 0%</div>
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Interactive Conversion Calculator Widget -->
  <div class="glass-card" style="margin-bottom: 28px;">
    <h3 style="font-size: 1.25rem; font-weight: 800; color: #ffffff; margin-bottom: 16px;">
      Interactive Multi-Month Cost Estimator
    </h3>
    <div style="display: flex; gap: 16px; flex-wrap: wrap; align-items: center; margin-bottom: 20px;">
      <div>
        <label style="display: block; font-size: 0.82rem; color: var(--text-dim); margin-bottom: 6px; font-weight: 700; text-transform: uppercase;">
          Subscription Duration:
        </label>
        <select id="monthsSelect" style="background: #090f1d; border: 1px solid var(--border-glass); color: #fff; padding: 10px 16px; border-radius: 10px; font-size: 0.95rem; outline: none;">
          <option value="1">1 Month</option>
          <option value="3">3 Months (Quarterly)</option>
          <option value="6">6 Months (Biannual)</option>
          <option value="12" selected>12 Months (1 Year)</option>
        </select>
      </div>

      <div style="flex: 1; min-width: 260px; background: rgba(6, 9, 19, 0.6); padding: 14px 18px; border-radius: 12px; border: 1px solid var(--border-glass);">
        <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
          <span style="font-size: 0.85rem; color: var(--text-dim);">Total Local Cost:</span>
          <span class="mono" id="calcLocalTotal" style="font-weight: 700; color: #38bdf8;">--</span>
        </div>
        <div style="display: flex; justify-content: space-between;">
          <span style="font-size: 0.85rem; color: var(--text-dim);">Total Converted USD:</span>
          <span class="mono" id="calcUsdTotal" style="font-weight: 700; color: #34d399;">--</span>
        </div>
      </div>
    </div>
  </div>

  <!-- FAQ Accordion / Cards -->
  <div class="glass-card" style="margin-bottom: 28px;">
    <h2 style="font-size: 1.3rem; font-weight: 800; margin-bottom: 16px;">Frequently Asked Questions</h2>
    <div style="margin-bottom: 18px;">
      <h3 style="font-size: 1.05rem; font-weight: 700; color: #f8fafc; margin-bottom: 6px;">
        What payment methods work for {product.name} in {country.name}?
      </h3>
      <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.6;">{product.paymentRestrictions}</p>
    </div>
    <div style="border-top: 1px solid var(--border-glass); padding-top: 16px;">
      <h3 style="font-size: 1.05rem; font-weight: 700; color: #f8fafc; margin-bottom: 6px;">
        Why does {product.name} cost differently across countries?
      </h3>
      <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.6;">
        Companies implement Purchasing Power Parity (PPP) pricing to make software affordable for local markets based on local average income and currency strength.
      </p>
    </div>
  </div>

  <!-- Related Countries Grid -->
  <div class="glass-card">
    <h3 style="font-size: 1.15rem; font-weight: 800; margin-bottom: 14px;">Compare {product.name} in Other Regions</h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 10px;">
      {normalized.map((other) => (
        <a
          href={`/${product.id}/price-in-${other.country.name.toLowerCase().replace(/\s+/g, '-')}`}
          class="btn btn-ghost"
          style="justify-content: space-between; font-size: 0.85rem; padding: 10px 14px;"
        >
          <span>{other.country.flag} {other.country.name}</span>
          <span class="mono" style="color: #34d399; font-weight: 700;">${other.usdPrice}</span>
        </a>
      ))}
    </div>
  </div>

  <script is:inline define:vars={{ localPrice, usdPrice, currency: country.currency }}>
    const select = document.getElementById('monthsSelect');
    const localTotalEl = document.getElementById('calcLocalTotal');
    const usdTotalEl = document.getElementById('calcUsdTotal');

    function updateCalc() {
      const months = parseInt(select.value, 10) || 1;
      const totalLocal = localPrice * months;
      const totalUsd = usdPrice * months;

      localTotalEl.textContent = `${currency} ${totalLocal.toLocaleString()}`;
      usdTotalEl.textContent = `$${totalUsd.toFixed(2)} USD`;
    }

    select.addEventListener('change', updateCalc);
    updateCalc();
  </script>
</Layout>

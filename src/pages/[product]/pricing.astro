---
import Layout from '../../layouts/Layout.astro';
import { SAAS_PRODUCTS, type SaaSProduct } from '../../data/products';
import { calculateNormalizedPrices, formatCurrencyLocal } from '../../utils/pricing';

export function getStaticPaths() {
  return SAAS_PRODUCTS.map((product) => ({
    params: { product: product.id },
    props: { product },
  }));
}

interface Props {
  product: SaaSProduct;
}

const { product } = Astro.props;
const primaryPlan = product.plans[0];
const normalized = calculateNormalizedPrices(primaryPlan);
const cheapest = normalized[0];
const usRate = normalized.find((i) => i.country.code === 'us') || normalized[normalized.length - 1];

const title = `${product.name} Pricing by Country (2026 Comparison Table)`;
const description = `Compare ${product.name} subscription costs across 15+ countries. See local currencies converted to USD. The cheapest country is ${cheapest.country.name} at $${cheapest.usdPrice}/mo.`;

const tableSchema = {
  "@context": "https://schema.org",
  "@type": "Table",
  "about": `${product.name} Pricing`,
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `Which country has the cheapest ${product.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${cheapest.country.name} (${cheapest.country.flag}) is currently the cheapest country for ${product.name} (${primaryPlan.planName}), priced at approximately $${cheapest.usdPrice.toFixed(2)} USD per month.`
      }
    },
    {
      "@type": "Question",
      "name": `Can I subscribe to ${product.name} with an international credit card?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": product.paymentRestrictions
      }
    }
  ]
};
---

<Layout title={title} description={description} canonicalPath={`/${product.id}/pricing`} jsonLd={[tableSchema, faqSchema]}>
  <div style="margin-bottom: 28px;">
    <div style="margin-bottom: 12px;">
      <a href="/" style="font-size: 0.88rem; color: var(--text-dim); display: inline-flex; align-items: center; gap: 6px;">
        ← Back to All Software Index
      </a>
    </div>
    <div style="display: flex; gap: 10px; align-items: center; margin-bottom: 8px;">
      <span class="badge badge-category">{product.category}</span>
      <span style="font-size: 0.82rem; color: #38bdf8;">Verified Regional Matrix</span>
    </div>
    <h1 style="font-size: 2.5rem; font-weight: 800; color: #ffffff; letter-spacing: -0.5px; margin: 6px 0;">
      {product.name} Pricing by Country
    </h1>
    <p style="color: var(--text-muted); font-size: 1.05rem; max-width: 820px;">{product.description}</p>
  </div>

  <!-- Key Metrics Row -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; margin-bottom: 28px;">
    <div class="glass-card" style="border-left: 4px solid #10b981; background: rgba(16, 185, 129, 0.05);">
      <span style="color: var(--text-dim); font-size: 0.82rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">Cheapest in World:</span>
      <div style="font-size: 1.5rem; font-weight: 800; color: #34d399; margin: 6px 0;">
        {cheapest.country.flag} {cheapest.country.name}
      </div>
      <div class="mono" style="font-size: 1.15rem; font-weight: 700; color: #f8fafc;">
        ${cheapest.usdPrice.toFixed(2)} <span style="font-size: 0.85rem; font-weight: 400; color: var(--text-dim);">USD/mo</span>
      </div>
    </div>

    <div class="glass-card">
      <span style="color: var(--text-dim); font-size: 0.82rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">US Baseline Price:</span>
      <div style="font-size: 1.5rem; font-weight: 800; color: #ffffff; margin: 6px 0;">
        🇺🇸 United States
      </div>
      <div class="mono" style="font-size: 1.15rem; font-weight: 700; color: var(--text-muted);">
        ${usRate.usdPrice.toFixed(2)} <span style="font-size: 0.85rem; font-weight: 400; color: var(--text-dim);">USD/mo</span>
      </div>
    </div>

    <div class="glass-card" style="border-left: 4px solid #38bdf8; background: rgba(56, 189, 248, 0.05);">
      <span style="color: var(--text-dim); font-size: 0.82rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">Maximum Global Spread:</span>
      <div style="font-size: 1.5rem; font-weight: 800; color: #38bdf8; margin: 6px 0;">
        {Math.abs(cheapest.differenceVsUSPercent)}% Discount
      </div>
      <span style="font-size: 0.88rem; color: var(--text-dim);">Between cheapest & standard pricing</span>
    </div>
  </div>

  <!-- Interactive Comparison Table with Live Search Filter -->
  <div class="glass-card" style="margin-bottom: 28px;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px; margin-bottom: 20px;">
      <div>
        <h2 style="font-size: 1.3rem; font-weight: 800; color: #ffffff;">{primaryPlan.planName} Tier Comparison</h2>
        <p style="font-size: 0.85rem; color: var(--text-dim);">Converted using current real-time foreign exchange benchmarks.</p>
      </div>
      <input 
        type="text" 
        id="countryTableSearch" 
        class="search-input" 
        placeholder="Filter country (e.g. Turkey, India, Japan)..." 
        style="max-width: 320px; padding: 8px 14px; font-size: 0.88rem;"
      />
    </div>

    <div class="table-container">
      <table class="data-table" id="pricingTable">
        <thead>
          <tr>
            <th style="width: 70px;">Rank</th>
            <th>Country / Region</th>
            <th>Local Listed Price</th>
            <th>Normalized USD</th>
            <th>vs US Benchmark</th>
            <th style="text-align: right;">Detailed Guide</th>
          </tr>
        </thead>
        <tbody>
          {normalized.map((item, index) => (
            <tr class="table-row-item" data-cname={item.country.name.toLowerCase()}>
              <td class="mono" style="color: var(--text-dim); font-weight: 700;">#{index + 1}</td>
              <td style="font-weight: 700;">
                <span style="margin-right: 8px; font-size: 1.1rem;">{item.country.flag}</span>
                <a href={`/${product.id}/price-in-${item.country.name.toLowerCase().replace(/\s+/g, '-')}`} style="color: #f8fafc;">
                  {item.country.name}
                </a>
              </td>
              <td class="mono" style="color: var(--text-muted);">{formatCurrencyLocal(item.localPrice, item.country.currency)}</td>
              <td class="mono" style="font-weight: 800; color: #ffffff; font-size: 1rem;">${item.usdPrice.toFixed(2)}</td>
              <td>
                {item.differenceVsUSPercent < 0 ? (
                  <span class="badge badge-cheapest">{item.differenceVsUSPercent}% Cheaper</span>
                ) : item.differenceVsUSPercent > 0 ? (
                  <span class="badge badge-expensive">+{item.differenceVsUSPercent}% Higher</span>
                ) : (
                  <span style="color: var(--text-dim); font-size: 0.82rem; font-weight: 600;">Baseline (0%)</span>
                )}
              </td>
              <td style="text-align: right;">
                <a href={`/${product.id}/price-in-${item.country.name.toLowerCase().replace(/\s+/g, '-')}`} class="btn btn-ghost" style="padding: 6px 12px; font-size: 0.82rem;">
                  Full Breakdown →
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Geo & Payment Restrictions Info Card -->
  <div class="glass-card">
    <h3 style="font-size: 1.25rem; font-weight: 800; color: #ffffff; margin-bottom: 12px;">Payment Requirements & Geo-Verification</h3>
    <p style="color: var(--text-muted); margin-bottom: 16px; font-size: 0.95rem;">{product.paymentRestrictions}</p>
    <div style="background: rgba(6, 9, 19, 0.7); padding: 18px; border-radius: 12px; border-left: 4px solid var(--primary); border: 1px solid var(--border-glass);">
      <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--primary); margin-bottom: 6px;">Advisory on Regional Subscriptions</h4>
      <p style="color: var(--text-dim); font-size: 0.88rem; line-height: 1.5;">
        Regional pricing tiers are intended for local domestic residents. Many digital vendors employ payment gateway checks, requiring cards registered within the billing territory. Always review each platform's service terms before managing cross-border digital accounts.
      </p>
    </div>
  </div>

  <script is:inline>
    const tableSearch = document.getElementById('countryTableSearch');
    const tableRows = document.querySelectorAll('.table-row-item');

    tableSearch.addEventListener('input', () => {
      const q = (tableSearch.value || '').toLowerCase().trim();
      tableRows.forEach(row => {
        const name = row.dataset.cname || '';
        row.style.display = name.includes(q) ? '' : 'none';
      });
    });
  </script>
</Layout>

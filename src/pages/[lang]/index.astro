---
import Layout from '../../layouts/Layout.astro';
import { SAAS_PRODUCTS } from '../../data/products';
import { calculateNormalizedPrices } from '../../utils/pricing';
import { SUPPORTED_LANGUAGES, type LangCode, t, getLocalizedPath } from '../../i18n/translations';

export function getStaticPaths() {
  const nonDefaultLangs = SUPPORTED_LANGUAGES.filter((l) => !l.isDefault);
  return nonDefaultLangs.map((lang) => ({
    params: { lang: lang.code },
    props: { lang: lang.code as LangCode },
  }));
}

interface Props {
  lang: LangCode;
}

const { lang } = Astro.props;

const title = t(lang, 'siteTitle');
const description = t(lang, 'heroDesc');

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "SaaSPriceGlobal",
  "url": `https://saas-pricing-global.pages.dev${getLocalizedPath('/', lang)}`,
  "description": description,
};
---

<Layout title={title} description={description} canonicalPath="/" lang={lang} jsonLd={[websiteSchema]}>
  <!-- Hero Section -->
  <div style="margin-bottom: 36px; text-align: center; max-width: 820px; margin-left: auto; margin-right: auto;">
    <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.25); padding: 6px 14px; border-radius: 9999px; font-size: 0.85rem; font-weight: 600; color: #38bdf8; margin-bottom: 16px;">
      <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #34d399; box-shadow: 0 0 8px #34d399;"></span>
      {t(lang, 'liveFxIndexed')}
    </div>
    <h1 style="font-size: 2.8rem; font-weight: 800; letter-spacing: -1px; line-height: 1.15; margin-bottom: 16px;">
      {t(lang, 'siteTagline').split(' ')[0]} {t(lang, 'siteTagline').split(' ')[1]} <span style="background: linear-gradient(135deg, var(--primary), var(--accent)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">{t(lang, 'siteTagline').split(' ').slice(2).join(' ')}</span>
    </h1>
    <p style="color: var(--text-muted); font-size: 1.12rem; line-height: 1.6; margin-bottom: 24px;">
      {t(lang, 'heroDesc')}
    </p>

    <!-- Real-time Live Market Pulse Ticker -->
    <div style="background: var(--bg-surface); border: 1px solid var(--border-glass); border-radius: 12px; padding: 10px 18px; margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; font-size: 0.84rem;">
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #34d399; box-shadow: 0 0 10px #34d399;"></span>
        <strong style="color: var(--text-primary);">{t(lang, 'liveArbitrageIndex')}</strong>
        <span style="color: var(--text-muted);">{t(lang, 'avgDisparity')}</span>
      </div>
      <div style="display: flex; gap: 16px; color: var(--text-dim);" class="mono">
        <span>🇹🇷 TRY/USD: <span style="color: var(--text-primary);">34.50</span></span>
        <span>🇮🇳 INR/USD: <span style="color: var(--text-primary);">84.10</span></span>
        <span>🇧🇷 BRL/USD: <span style="color: var(--text-primary);">5.60</span></span>
      </div>
    </div>

    <!-- Market Hook Banner -->
    <div class="glass-card" style="text-align: left; background: var(--bg-surface); border: 1px solid var(--border-glass); padding: 18px 24px; margin-bottom: 32px;">
      <div style="display: flex; gap: 14px; align-items: center;">
        <span style="font-size: 1.8rem;">💡</span>
        <div style="flex: 1;">
          <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text-primary); margin-bottom: 4px;">{t(lang, 'whyDiffTitle')}</h3>
          <p style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; margin: 0;">
            {t(lang, 'whyDiffDesc')}
          </p>
        </div>
        <a href={getLocalizedPath('/guide', lang)} style="color: var(--primary); font-weight: 700; font-size: 0.85rem; white-space: nowrap; border: 1px solid var(--border-glass-hover); padding: 8px 14px; border-radius: 8px; background: var(--primary-glow);">{t(lang, 'readGuide')}</a>
      </div>
    </div>

    <!-- Interactive Client Search & Filter -->
    <div class="filter-bar" style="margin-top: 32px; justify-content: center; gap: 16px;">
      <input
        type="text"
        id="saasSearch"
        class="search-input"
        placeholder={t(lang, 'searchPlaceholder')}
      />
      
      <!-- Custom Non-Native Category Selectbox -->
      <div class="custom-select-wrapper" id="categorySelectWrapper" style="min-width: 220px;">
        <div class="custom-select-trigger" id="categorySelectTrigger">
          <span id="categorySelectLabel">{t(lang, 'allCategories')}</span>
          <span style="font-size: 0.75rem; color: var(--primary);">▼</span>
        </div>
        <div class="custom-select-options">
          <div class="custom-option selected" data-cat="all">{t(lang, 'allCategories')}</div>
          <div class="custom-option" data-cat="AI & Dev">{t(lang, 'aiDev')}</div>
          <div class="custom-option" data-cat="Streaming">{t(lang, 'streaming')}</div>
          <div class="custom-option" data-cat="Design & Creative">{t(lang, 'design')}</div>
          <div class="custom-option" data-cat="Productivity">{t(lang, 'productivity')}</div>
        </div>
      </div>
    </div>
  </div>

  <!-- SaaS Cards Grid -->
  <div id="productGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 24px;">
    {SAAS_PRODUCTS.map((prod) => {
      const primaryPlan = prod.plans[0];
      const normalized = calculateNormalizedPrices(primaryPlan);
      const cheapest = normalized[0];
      const expensive = normalized[normalized.length - 1];
      const savings = Math.abs(cheapest.differenceVsUSPercent);

      return (
        <div class="glass-card hoverable product-card" data-name={prod.name.toLowerCase()} data-cat={prod.category} style="display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
              <span class="badge badge-category">{prod.category}</span>
              <span class="badge badge-cheapest">Up to {savings}% OFF</span>
            </div>
            <h2 style="font-size: 1.45rem; font-weight: 700; color: var(--text-primary); margin-bottom: 8px;">
              <a href={getLocalizedPath(`/${prod.id}/pricing`, lang)} style="display: flex; align-items: center; justify-content: space-between;">
                <span>{prod.name}</span>
                <span style="font-size: 1.1rem; color: var(--text-dim);">→</span>
              </a>
            </h2>
            <p style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; margin-bottom: 18px;">
              {prod.description}
            </p>
          </div>

          <div style="border-top: 1px solid var(--border-glass); padding-top: 16px;">
            <div style="background: var(--card-bg-subtle); padding: 12px 14px; border-radius: 10px; margin-bottom: 16px; border: 1px solid var(--border-glass);">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <span style="font-size: 0.82rem; color: var(--text-dim);">{t(lang, 'lowestInWorld')}</span>
                <span class="mono" style="font-size: 0.95rem; font-weight: 700; color: #34d399;">
                  {cheapest.country.flag} ${cheapest.usdPrice.toFixed(2)}/mo
                </span>
              </div>
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 0.82rem; color: var(--text-dim);">{t(lang, 'usBaseline')}</span>
                <span class="mono" style="font-size: 0.88rem; color: var(--text-primary); font-weight: 600;">
                  🇺🇸 ${expensive.usdPrice.toFixed(2)}/mo
                </span>
              </div>
            </div>

            <div style="display: flex; gap: 10px;">
              <a href={getLocalizedPath(`/${prod.id}/pricing`, lang)} class="btn btn-primary" style="flex: 1; font-size: 0.85rem; text-align: center; padding: 10px 14px; border-radius: 10px;">
                {t(lang, 'exploreCountries', { n: normalized.length })}
              </a>
              <a href={getLocalizedPath(`/cheapest-country-to-buy-${prod.id}`, lang)} class="btn btn-ghost" title="View Rankings" style="font-size: 0.85rem; padding: 10px 14px; border-radius: 10px;">
                🏆
              </a>
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <!-- Interactive Interest & FAQ Insights Accordion -->
  <div style="margin-top: 64px;">
    <div style="text-align: center; margin-bottom: 36px;">
      <span class="badge badge-cheapest" style="margin-bottom: 8px;">{t(lang, 'marketIntelFaq')}</span>
      <h2 style="font-size: 2rem; font-weight: 800; color: var(--text-primary); letter-spacing: -0.5px;">
        {t(lang, 'everythingYouNeed')}
      </h2>
      <p style="color: var(--text-muted); font-size: 0.95rem; max-width: 600px; margin: 8px auto 0;">
        {t(lang, 'faqSubtitle')}
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px;">
      <div class="glass-card">
        <div style="font-size: 1.5rem; margin-bottom: 12px;">🌍</div>
        <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--text-primary); margin-bottom: 8px;">{t(lang, 'faqWhyNotSame')}</h3>
        <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6;">
          {t(lang, 'faqWhyNotSameAns')}
        </p>
      </div>

      <div class="glass-card">
        <div style="font-size: 1.5rem; margin-bottom: 12px;">💳</div>
        <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--text-primary); margin-bottom: 8px;">{t(lang, 'faqCanIntlPay')}</h3>
        <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6;">
          {t(lang, 'faqCanIntlPayAns')}
        </p>
      </div>

      <div class="glass-card">
        <div style="font-size: 1.5rem; margin-bottom: 12px;">📊</div>
        <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--text-primary); margin-bottom: 8px;">{t(lang, 'faqHowOftenFx')}</h3>
        <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6;">
          {t(lang, 'faqHowOftenFxAns')}
        </p>
      </div>
    </div>
  </div>

  <script is:inline>
    const searchInput = document.getElementById('saasSearch');
    const selectWrapper = document.getElementById('categorySelectWrapper');
    const selectTrigger = document.getElementById('categorySelectTrigger');
    const selectLabel = document.getElementById('categorySelectLabel');
    const categoryOptions = document.querySelectorAll('#categorySelectWrapper .custom-option');
    const productCards = document.querySelectorAll('.product-card');
    let currentCategory = 'all';

    function applyFilter() {
      const query = (searchInput.value || '').toLowerCase().trim();
      productCards.forEach((card) => {
        const name = card.dataset.name || '';
        const cat = card.dataset.cat || '';
        const matchesSearch = name.includes(query);
        const matchesCategory = currentCategory === 'all' || cat === currentCategory;

        if (matchesSearch && matchesCategory) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', applyFilter);
    }

    if (selectTrigger && selectWrapper) {
      selectTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        selectWrapper.classList.toggle('open');
      });

      document.addEventListener('click', () => {
        selectWrapper.classList.remove('open');
      });

      categoryOptions.forEach((opt) => {
        opt.addEventListener('click', () => {
          categoryOptions.forEach((o) => o.classList.remove('selected'));
          opt.classList.add('selected');
          currentCategory = opt.dataset.cat;
          if (selectLabel) selectLabel.textContent = opt.textContent;
          applyFilter();
          selectWrapper.classList.remove('open');
        });
      });
    }
  </script>
</Layout>

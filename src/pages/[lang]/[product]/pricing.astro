---
import Layout from '../../../layouts/Layout.astro';
import { SAAS_PRODUCTS, type SaaSProduct } from '../../../data/products';
import { calculateNormalizedPrices, formatCurrencyLocal } from '../../../utils/pricing';
import { SUPPORTED_LANGUAGES, type LangCode, t, getLocalizedPath } from '../../../i18n/translations';

export function getStaticPaths() {
  const nonDefaultLangs = SUPPORTED_LANGUAGES.filter((l) => !l.isDefault);
  const paths = [];

  for (const lang of nonDefaultLangs) {
    for (const product of SAAS_PRODUCTS) {
      paths.push({
        params: { lang: lang.code, product: product.id },
        props: { product, lang: lang.code as LangCode },
      });
    }
  }

  return paths;
}

interface Props {
  product: SaaSProduct;
  lang: LangCode;
}

const { product, lang } = Astro.props;
const primaryPlan = product.plans[0];
const normalized = calculateNormalizedPrices(primaryPlan);
const cheapest = normalized[0];
const usRate = normalized.find((i) => i.country.code === 'us') || normalized[normalized.length - 1];

const title = `${t(lang, 'pricingByCountry', { name: product.name })} (2026)`;
const description = `Compare ${product.name} subscription costs across 15+ countries in ${lang.toUpperCase()}.`;
---

<Layout title={title} description={description} canonicalPath={`/${product.id}/pricing`} lang={lang}>
  <div style="margin-bottom: 28px;">
    <div style="margin-bottom: 12px;">
      <a href={getLocalizedPath('/', lang)} style="font-size: 0.88rem; color: var(--text-dim); display: inline-flex; align-items: center; gap: 6px;">
        {t(lang, 'backToAll')}
      </a>
    </div>
    <div style="display: flex; gap: 10px; align-items: center; margin-bottom: 8px;">
      <span class="badge badge-category">{product.category}</span>
      <span style="font-size: 0.82rem; color: #38bdf8;">{t(lang, 'verifiedMatrix')}</span>
    </div>
    <h1 style="font-size: 2.5rem; font-weight: 800; color: var(--text-primary); letter-spacing: -0.5px; margin: 6px 0;">
      {t(lang, 'pricingByCountry', { name: product.name })}
    </h1>
    <p style="color: var(--text-muted); font-size: 1.05rem; max-width: 820px;">{product.description}</p>
  </div>

  <!-- Key Metrics Row -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; margin-bottom: 28px;">
    <div class="glass-card" style="border-left: 4px solid #10b981; background: var(--card-bg-subtle);">
      <span style="color: var(--text-dim); font-size: 0.82rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">{t(lang, 'cheapestInWorldBadge')}</span>
      <div style="font-size: 1.5rem; font-weight: 800; color: #34d399; margin: 6px 0;">
        {cheapest.country.flag} {cheapest.country.name}
      </div>
      <div class="mono" style="font-size: 1.15rem; font-weight: 700; color: var(--text-primary);">
        ${cheapest.usdPrice.toFixed(2)} <span style="font-size: 0.85rem; font-weight: 400; color: var(--text-dim);">USD/mo</span>
      </div>
    </div>

    <div class="glass-card" style="background: var(--card-bg-subtle); border-left: 4px solid var(--border-glass-hover);">
      <span style="color: var(--text-dim); font-size: 0.82rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">{t(lang, 'usBaseline')}</span>
      <div style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary); margin: 6px 0;">
        🇺🇸 United States
      </div>
      <div class="mono" style="font-size: 1.15rem; font-weight: 700; color: var(--text-muted);">
        ${usRate.usdPrice.toFixed(2)} <span style="font-size: 0.85rem; font-weight: 400; color: var(--text-dim);">USD/mo</span>
      </div>
    </div>

    <div class="glass-card" style="border-left: 4px solid var(--primary); background: var(--card-bg-subtle);">
      <span style="color: var(--text-dim); font-size: 0.82rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">{t(lang, 'maxGlobalSpread')}</span>
      <div style="font-size: 1.5rem; font-weight: 800; color: var(--primary); margin: 6px 0;">
        {Math.abs(cheapest.differenceVsUSPercent)}% Discount
      </div>
      <span style="font-size: 0.88rem; color: var(--text-dim);">Between cheapest & standard pricing</span>
    </div>
  </div>

  <!-- Global Arbitrage Bar Chart Ranking -->
  <div class="glass-card" style="margin-bottom: 28px;">
    <h3 style="font-size: 1.25rem; font-weight: 800; color: var(--text-primary); margin-bottom: 20px;">
      {t(lang, 'arbitrageVisualizer')}
    </h3>
    <div style="display: flex; flex-direction: column; gap: 14px;">
      {normalized.slice(0, 8).map((item) => {
        return (
          <div>
            <div style="display: flex; justify-content: space-between; font-size: 0.88rem; margin-bottom: 6px;">
              <span style="font-weight: 600; color: var(--text-primary); display: flex; align-items: center; gap: 8px;">
                <span>{item.country.flag}</span>
                <span>{item.country.name}</span>
              </span>
              <span class="mono" style="font-weight: 700; color: #34d399;">
                ${item.usdPrice.toFixed(2)}/mo <span style="color: var(--text-dim); font-size: 0.8rem;">({item.differenceVsUSPercent}%)</span>
              </span>
            </div>
            <div style="width: 100%; height: 8px; background: var(--border-glass); border-radius: 9999px; overflow: hidden;">
              <div style={`width: ${Math.min(100, Math.max(12, (item.usdPrice / usRate.usdPrice) * 100))}%; height: 100%; background: linear-gradient(90deg, #34d399, var(--primary)); border-radius: 9999px;`}></div>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Interactive Comparison Table with Live Search Filter -->
  <div class="glass-card" style="margin-bottom: 28px;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px; margin-bottom: 20px;">
      <div>
        <h2 style="font-size: 1.3rem; font-weight: 800; color: var(--text-primary);">{t(lang, 'tierComparison', { plan: primaryPlan.planName })}</h2>
        <p style="font-size: 0.85rem; color: var(--text-dim);">Converted using current real-time foreign exchange benchmarks.</p>
      </div>
      <input 
        type="text" 
        id="countryTableSearch" 
        class="search-input" 
        placeholder={t(lang, 'filterCountryPlaceholder')}
        style="max-width: 320px; padding: 8px 14px; font-size: 0.88rem;"
      />
    </div>

    <div class="table-container">
      <table class="data-table" id="pricingTable" style="width: 100%; border-collapse: collapse;">
        <thead>
          <tr style="border-bottom: 1px solid var(--border-glass);">
            <th style="width: 70px; padding: 14px 16px; text-align: left; color: var(--text-dim);">{t(lang, 'rank')}</th>
            <th style="padding: 14px 16px; text-align: left; color: var(--text-dim);">{t(lang, 'countryRegion')}</th>
            <th style="padding: 14px 16px; text-align: left; color: var(--text-dim);">{t(lang, 'localListedPrice')}</th>
            <th style="padding: 14px 16px; text-align: left; color: var(--text-dim);">{t(lang, 'normalizedUsd')}</th>
            <th style="padding: 14px 16px; text-align: left; color: var(--text-dim);">{t(lang, 'vsUsBenchmark')}</th>
            <th style="padding: 14px 16px; text-align: right; color: var(--text-dim);">{t(lang, 'detailedGuide')}</th>
          </tr>
        </thead>
        <tbody>
          {normalized.map((item, index) => (
            <tr class="table-row-item" data-cname={item.country.name.toLowerCase()} style="border-bottom: 1px solid var(--border-glass);">
              <td class="mono" style="padding: 14px 16px; color: var(--text-dim); font-weight: 700;">#{index + 1}</td>
              <td style="padding: 14px 16px; font-weight: 700;">
                <span style="margin-right: 8px; font-size: 1.1rem;">{item.country.flag}</span>
                <a href={getLocalizedPath(`/${product.id}/price-in-${item.country.name.toLowerCase().replace(/\s+/g, '-')}`, lang)} style="color: var(--text-primary);">
                  {item.country.name}
                </a>
              </td>
              <td class="mono" style="padding: 14px 16px; color: var(--text-muted);">{formatCurrencyLocal(item.localPrice, item.country.currency)}</td>
              <td class="mono" style="padding: 14px 16px; font-weight: 800; color: var(--text-primary); font-size: 1rem;">${item.usdPrice.toFixed(2)}</td>
              <td>
                {item.differenceVsUSPercent < 0 ? (
                  <span class="badge badge-cheapest">{t(lang, 'cheaper', { n: Math.abs(item.differenceVsUSPercent) })}</span>
                ) : item.differenceVsUSPercent > 0 ? (
                  <span class="badge badge-expensive">{t(lang, 'higher', { n: item.differenceVsUSPercent })}</span>
                ) : (
                  <span style="color: var(--text-dim); font-size: 0.82rem; font-weight: 600;">{t(lang, 'baseline0')}</span>
                )}
              </td>
              <td style="text-align: right;">
                <a href={getLocalizedPath(`/${product.id}/price-in-${item.country.name.toLowerCase().replace(/\s+/g, '-')}`, lang)} class="btn btn-ghost" style="padding: 6px 12px; font-size: 0.82rem;">
                  {t(lang, 'fullBreakdown')}
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Geo & Payment Restrictions Info Card -->
  <div class="glass-card">
    <h3 style="font-size: 1.25rem; font-weight: 800; color: var(--text-primary); margin-bottom: 12px;">{t(lang, 'paymentReqs')}</h3>
    <p style="color: var(--text-muted); margin-bottom: 16px; font-size: 0.95rem;">{product.paymentRestrictions}</p>
    <div style="background: var(--card-bg-subtle); padding: 18px; border-radius: 12px; border-left: 4px solid var(--primary); border: 1px solid var(--border-glass);">
      <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--primary); margin-bottom: 6px;">{t(lang, 'advisory')}</h4>
      <p style="color: var(--text-dim); font-size: 0.88rem; line-height: 1.5;">
        {t(lang, 'advisoryDesc')}
      </p>
    </div>
  </div>

  <script is:inline>
    const tableSearch = document.getElementById('countryTableSearch');
    const tableRows = document.querySelectorAll('.table-row-item');

    if (tableSearch) {
      tableSearch.addEventListener('input', () => {
        const q = (tableSearch.value || '').toLowerCase().trim();
        tableRows.forEach(row => {
          const name = row.dataset.cname || '';
          row.style.display = name.includes(q) ? '' : 'none';
        });
      });
    }
  </script>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import { SAAS_PRODUCTS, type SaaSProduct } from '../data/products';
import { calculateNormalizedPrices, formatCurrencyLocal } from '../utils/pricing';

export function getStaticPaths() {
  return SAAS_PRODUCTS.map((product) => ({
    params: { slug: `cheapest-country-to-buy-${product.id}` },
    props: { product },
  }));
}

interface Props {
  product: SaaSProduct;
}

const { product } = Astro.props;
const primaryPlan = product.plans[0];
const normalized = calculateNormalizedPrices(primaryPlan);
const cheapest = normalized[0];
const top5Cheapest = normalized.slice(0, 5);

const title = `Cheapest Country to Buy ${product.name} (2026 Rankings & Savings)`;
const description = `Which country has the cheapest ${product.name} subscription? ${cheapest.country.name} (${cheapest.country.flag}) ranks #1 at $${cheapest.usdPrice.toFixed(2)}/mo. See top 5 lowest-priced regions.`;
---

<Layout title={title} description={description} canonicalPath={`/cheapest-country-to-buy-${product.id}`}>
  <div style="margin-bottom: 28px;">
    <div style="margin-bottom: 12px;">
      <a href={`/${product.id}/pricing`} style="font-size: 0.88rem; color: var(--text-dim); display: inline-flex; align-items: center; gap: 6px;">
        ← Back to {product.name} Full Table
      </a>
    </div>
    <div style="display: flex; gap: 10px; align-items: center; margin-bottom: 8px;">
      <span class="badge badge-cheapest">🏆 Global Rankings</span>
      <span style="font-size: 0.82rem; color: #38bdf8;">Lowest Subscription Analysis</span>
    </div>
    <h1 style="font-size: 2.5rem; font-weight: 800; color: #ffffff; letter-spacing: -0.5px; margin: 6px 0;">
      Cheapest Country to Buy {product.name}
    </h1>
    <p style="color: var(--text-muted); font-size: 1.05rem; max-width: 820px;">
      We analyzed subscription rates across 15+ currencies to find the lowest price in the world for {product.name}.
    </p>
  </div>

  <!-- Hero Highlight Card -->
  <div class="glass-card" style="background: linear-gradient(135deg, rgba(6, 78, 59, 0.5) 0%, rgba(6, 9, 19, 0.9) 100%); border: 1px solid rgba(16, 185, 129, 0.4); text-align: center; padding: 42px 24px; margin-bottom: 28px; position: relative; overflow: hidden;">
    <div style="position: absolute; top: -50px; left: 50%; transform: translateX(-50%); width: 200px; height: 100px; background: rgba(52, 211, 153, 0.2); filter: blur(50px); border-radius: 50%;"></div>
    <span style="color: #6ee7b7; font-weight: 700; text-transform: uppercase; font-size: 0.82rem; letter-spacing: 1px;">
      ★ Current #1 Lowest Worldwide Price
    </span>
    <div style="font-size: 3.2rem; font-weight: 900; color: #ffffff; letter-spacing: -0.5px; margin: 12px 0;">
      {cheapest.country.flag} {cheapest.country.name}
    </div>
    <div class="mono" style="font-size: 2.4rem; font-weight: 900; color: #34d399; margin-bottom: 8px;">
      ${cheapest.usdPrice.toFixed(2)} <span style="font-size: 1.1rem; color: #a7f3d0; font-weight: 400;">USD / month</span>
    </div>
    <div style="color: var(--text-muted); font-size: 0.95rem;">
      Official local rate: <strong style="color: #fff;">{formatCurrencyLocal(cheapest.localPrice, cheapest.country.currency)}</strong> ({cheapest.differenceVsUSPercent}% cheaper than standard US pricing)
    </div>
  </div>

  <!-- Top 5 List -->
  <div class="glass-card" style="margin-bottom: 28px;">
    <h2 style="font-size: 1.35rem; font-weight: 800; color: #ffffff; margin-bottom: 20px;">Top 5 Lowest-Priced Regions for {product.name}</h2>
    <div style="display: flex; flex-direction: column; gap: 14px;">
      {top5Cheapest.map((item, index) => (
        <div style="display: flex; justify-content: space-between; align-items: center; background: rgba(6, 9, 19, 0.6); padding: 16px 20px; border-radius: 12px; border: 1px solid var(--border-glass);">
          <div style="display: flex; align-items: center; gap: 16px;">
            <span class="mono" style="font-size: 1.25rem; font-weight: 800; color: #38bdf8; width: 28px;">#{index + 1}</span>
            <span style="font-size: 1.6rem;">{item.country.flag}</span>
            <div>
              <div style="font-weight: 700; color: #f8fafc; font-size: 1.05rem;">{item.country.name}</div>
              <div class="mono" style="font-size: 0.85rem; color: var(--text-dim);">{formatCurrencyLocal(item.localPrice, item.country.currency)}</div>
            </div>
          </div>
          <div style="text-align: right;">
            <div class="mono" style="font-weight: 800; color: #34d399; font-size: 1.2rem;">${item.usdPrice.toFixed(2)}/mo</div>
            <div style="font-size: 0.8rem; color: var(--text-dim);">{item.differenceVsUSPercent}% vs US</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>

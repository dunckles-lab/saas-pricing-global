---
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  jsonLd?: object[];
}

const { title, description, canonicalPath = '', jsonLd = [] } = Astro.props;
const siteUrl = 'https://saas-pricing-global.pages.dev';
const canonicalUrl = `${siteUrl}${canonicalPath}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <!-- Prevent Light/Dark Mode Flash -->
    <script is:inline>
      (function() {
        const t = localStorage.getItem('theme');
        if (t === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

    <!-- Open Graph & Twitter -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- JSON-LD Structured Data -->
    {jsonLd.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <style is:global>
      :root {
        --bg-main: #060913;
        --bg-surface: #0e1526;
        --bg-glass: rgba(16, 24, 42, 0.75);
        --border-glass: rgba(255, 255, 255, 0.08);
        --border-glass-hover: rgba(56, 189, 248, 0.35);
        --primary: #38bdf8;
        --primary-glow: rgba(56, 189, 248, 0.25);
        --accent: #6366f1;
        --success: #10b981;
        --success-glow: rgba(16, 185, 129, 0.2);
        --danger: #f43f5e;
        --text-primary: #f8fafc;
        --text-muted: #94a3b8;
        --text-dim: #64748b;
        --nav-bg: rgba(6, 9, 19, 0.85);
        --card-bg-subtle: rgba(6, 9, 19, 0.6);
        --table-row-hover: rgba(56, 189, 248, 0.05);
      }

      [data-theme="light"] {
        --bg-main: #f8fafc;
        --bg-surface: #ffffff;
        --bg-glass: rgba(255, 255, 255, 0.95);
        --border-glass: rgba(0, 0, 0, 0.1);
        --border-glass-hover: rgba(2, 132, 199, 0.5);
        --primary: #0284c7;
        --primary-glow: rgba(2, 132, 199, 0.15);
        --accent: #4f46e5;
        --success: #059669;
        --success-glow: rgba(5, 150, 105, 0.15);
        --danger: #e11d48;
        --text-primary: #0f172a;
        --text-muted: #334155;
        --text-dim: #64748b;
        --nav-bg: rgba(255, 255, 255, 0.95);
        --card-bg-subtle: #f1f5f9;
        --table-row-hover: rgba(2, 132, 199, 0.08);
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        background-color: var(--bg-main);
        background-image: 
          radial-gradient(at 0% 0%, var(--primary-glow) 0px, transparent 50%),
          radial-gradient(at 100% 100%, rgba(99, 102, 241, 0.1) 0px, transparent 50%);
        background-attachment: fixed;
        color: var(--text-primary);
        line-height: 1.6;
        padding-bottom: 80px;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
        transition: background-color 0.3s ease, color 0.3s ease;
      }

      /* Global Link Styling & Visited Reset */
      a, a:visited {
        color: inherit;
        text-decoration: none;
        transition: all 0.2s ease;
      }
      a:hover {
        color: var(--primary);
      }

      h1, h2, h3, h4, strong {
        color: var(--text-primary);
      }
      h1 a, h2 a, h3 a, h4 a,
      h1 a:visited, h2 a:visited, h3 a:visited, h4 a:visited {
        color: var(--text-primary) !important;
      }
      h1 a:hover, h2 a:hover, h3 a:hover, h4 a:hover {
        color: var(--primary) !important;
      }

      .btn, .btn:visited, .btn-primary, .btn-primary:visited {
        text-decoration: none;
      }

      .btn-primary, .btn-primary:visited {
        background: linear-gradient(135deg, #0284c7 0%, #6366f1 100%);
        color: #ffffff !important;
      }

      .btn-ghost, .btn-ghost:visited {
        background: var(--card-bg-subtle);
        border: 1px solid var(--border-glass);
        color: var(--text-primary) !important;
      }
      .btn-ghost:hover {
        background: var(--primary-glow);
        border-color: var(--primary);
        color: var(--primary) !important;
      }

      .table-row-item td {
        padding: 14px 16px;
      }
      .table-row-item a,
      .table-row-item a:visited {
        color: var(--text-primary) !important;
      }
      .table-row-item a:hover {
        color: var(--primary) !important;
      }
      .table-row-item .mono {
        color: var(--text-primary);
      }
      .mono { font-family: 'JetBrains Mono', monospace; }

      .container { max-width: 1140px; margin: 0 auto; padding: 0 24px; }

      /* Modern Glassmorphic Nav */
      .navbar {
        position: sticky;
        top: 0;
        z-index: 100;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        background: var(--nav-bg);
        border-bottom: 1px solid var(--border-glass);
        transition: background 0.3s ease;
      }
      .navbar-inner {
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .brand-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 800;
        font-size: 1.25rem;
        letter-spacing: -0.5px;
      }
      .brand-logo span.gradient {
        background: linear-gradient(135deg, #38bdf8 0%, #818cf8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .brand-icon {
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, #0284c7, #6366f1);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        box-shadow: 0 0 16px var(--primary-glow);
      }
      .nav-links { display: flex; align-items: center; gap: 24px; font-size: 0.92rem; font-weight: 600; }
      .nav-links a, .nav-links a:visited { color: var(--text-muted); }
      .nav-links a:hover { color: var(--primary); }

      /* Interactive Glass Card */
      .glass-card {
        background: var(--bg-glass);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--border-glass);
        border-radius: 16px;
        padding: 24px;
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
      }
      .glass-card.hoverable:hover {
        transform: translateY(-4px);
        border-color: var(--border-glass-hover);
        box-shadow: 0 16px 32px -8px rgba(0, 0, 0, 0.5), 0 0 20px rgba(56, 189, 248, 0.1);
      }

      /* Badges & Pills */
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.3px;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 9999px;
      }
      .badge-category {
        background: rgba(99, 102, 241, 0.15);
        color: #a5b4fc;
        border: 1px solid rgba(99, 102, 241, 0.3);
      }
      .badge-cheapest {
        background: rgba(16, 185, 129, 0.15);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.3);
      }
      .badge-expensive {
        background: rgba(244, 63, 94, 0.15);
        color: #fb7185;
        border: 1px solid rgba(244, 63, 94, 0.3);
      }

      /* Buttons */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s ease;
        border: none;
      }
      .btn-primary {
        background: linear-gradient(135deg, #0284c7, #2563eb);
        color: #fff;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3);
      }
      .btn-primary:hover {
        background: linear-gradient(135deg, #0369a1, #1d4ed8);
        box-shadow: 0 6px 20px rgba(37, 99, 235, 0.45);
        transform: translateY(-1px);
      }
      .btn-ghost {
        background: rgba(255, 255, 255, 0.05);
        color: var(--text-muted);
        border: 1px solid var(--border-glass);
      }
      .btn-ghost:hover {
        background: rgba(255, 255, 255, 0.1);
        color: var(--text-primary);
        border-color: rgba(255, 255, 255, 0.2);
      }

      /* Native Interactive Table */
      .table-container {
        width: 100%;
        overflow-x: auto;
        border-radius: 12px;
        border: 1px solid var(--border-glass);
        background: var(--bg-surface);
      }
      table.data-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        font-size: 0.92rem;
      }
      table.data-table th {
        background: var(--card-bg-subtle) !important;
        padding: 14px 18px;
        color: var(--text-dim) !important;
        font-weight: 700;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid var(--border-glass);
      }
      table.data-table td {
        padding: 14px 18px;
        border-bottom: 1px solid var(--border-glass);
        background: var(--bg-surface) !important;
        color: var(--text-primary) !important;
        transition: background 0.15s ease;
      }
      table.data-table tr:hover td {
        background: var(--table-row-hover) !important;
      }
      table.data-table tr:last-child td {
        border-bottom: none;
      }

      /* Search & Filter Bar */
      .filter-bar {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 24px;
        align-items: center;
      }
      /* Input and form elements */
      .search-input {
        background: var(--bg-surface);
        border: 1px solid var(--border-glass);
        color: var(--text-primary);
        padding: 12px 18px;
        border-radius: 12px;
        font-size: 0.95rem;
        outline: none;
        flex: 1;
        min-width: 260px;
        transition: border-color 0.2s, box-shadow 0.2s, background-color 0.3s;
      }
      .search-input::placeholder {
        color: var(--text-dim);
      }
      .search-input:focus {
        border-color: var(--primary);
        box-shadow: 0 0 16px var(--primary-glow);
      }

      /* Custom Dropdown / Selectbox Component */
      .custom-select-wrapper {
        position: relative;
        user-select: none;
        display: inline-block;
      }
      .custom-select-trigger {
        background: var(--bg-surface);
        border: 1px solid var(--border-glass);
        color: var(--text-primary);
        padding: 10px 16px;
        border-radius: 12px;
        font-size: 0.92rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        transition: all 0.2s ease;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
      }
      .custom-select-trigger:hover {
        border-color: var(--primary);
        box-shadow: 0 0 12px var(--primary-glow);
      }
      .custom-select-options {
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        right: 0;
        min-width: 100%;
        background: var(--bg-surface);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--border-glass);
        border-radius: 12px;
        box-shadow: 0 16px 32px rgba(0, 0, 0, 0.4);
        z-index: 99;
        overflow: hidden;
        display: none;
        flex-direction: column;
      }
      .custom-select-wrapper.open .custom-select-options {
        display: flex;
      }
      .custom-option {
        padding: 10px 16px;
        font-size: 0.9rem;
        color: var(--text-muted);
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: background 0.15s ease, color 0.15s ease;
      }
      .custom-option:hover, .custom-option.selected {
        background: var(--primary-glow);
        color: var(--primary);
        font-weight: 700;
      }

      /* Theme Toggle Button */
      .theme-toggle-btn {
        background: var(--bg-surface);
        border: 1px solid var(--border-glass);
        color: var(--text-primary);
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 1.15rem;
        transition: all 0.2s ease;
      }
      .theme-toggle-btn:hover {
        border-color: var(--primary);
        box-shadow: 0 0 12px var(--primary-glow);
        transform: scale(1.05);
      }

      /* Sponsored Banner Slot */
      .ad-banner {
        background: var(--card-bg-subtle);
        border: 1px dashed var(--border-glass-hover);
        border-radius: 12px;
        padding: 14px;
        text-align: center;
        color: var(--text-dim);
        font-size: 0.8rem;
        margin: 28px 0;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: background-color 0.3s ease, border-color 0.3s ease;
      }

      /* Global Table Typography & Styling */
      table {
        width: 100%;
        border-collapse: collapse;
        color: var(--text-primary);
      }
      thead th {
        color: var(--text-dim) !important;
        border-bottom: 1px solid var(--border-glass);
      }
      tbody td {
        border-bottom: 1px solid var(--border-glass);
        color: var(--text-primary);
      }
      tbody tr {
        transition: background-color 0.15s ease;
      }
      tbody tr:hover {
        background: var(--table-row-hover);
      }
    </style>
  </head>
  <body>
    <nav class="navbar">
      <div class="container navbar-inner">
        <a href="/" class="brand-logo">
          <div class="brand-icon">⚡</div>
          <span>SaaS<span class="gradient">Price</span>Global</span>
        </a>
        <div class="nav-links">
          <a href="/">All Software</a>
          <a href="/guide">PPP Guide</a>
          <a href="/cheapest-country-to-buy-chatgpt-plus">ChatGPT Index</a>
          <a href="/cheapest-country-to-buy-spotify-premium">Spotify Index</a>
          <button id="themeToggle" class="theme-toggle-btn" aria-label="Toggle Theme" title="Toggle Light/Dark Theme">
            🌙
          </button>
        </div>
      </div>
    </nav>

    <div class="container" style="margin-top: 36px;">
      <div class="ad-banner" data-ad-slot="AUTO">
        <span>📢 Sponsored Partner • Global Borderless Billing & Virtual Cards</span>
      </div>

      <slot />

      <div class="ad-banner" data-ad-slot="AUTO" style="margin-top: 48px;">
        <span>🔒 Secure Worldwide SaaS Payments • High-RPM Ad Network Placement</span>
      </div>

      <footer style="margin-top: 64px; padding-top: 32px; border-top: 1px solid var(--border-glass); text-align: center; color: var(--text-dim); font-size: 0.88rem;">
        <p>© 2026 SaaSPriceGlobal. Continuous purchasing power parity and global software cost tracking.</p>
        <p style="margin-top: 6px; font-size: 0.82rem;">Updated automatically via real-time foreign exchange rates. Not affiliated with referenced SaaS vendors.</p>
      </footer>
    </div>

    <!-- Theme Toggle Persistence Script -->
    <script is:inline>
      const toggleBtn = document.getElementById('themeToggle');
      const savedTheme = localStorage.getItem('theme') || 'dark';

      function setTheme(theme) {
        if (theme === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
          if (toggleBtn) toggleBtn.textContent = '☀️';
        } else {
          document.documentElement.removeAttribute('data-theme');
          if (toggleBtn) toggleBtn.textContent = '🌙';
        }
        localStorage.setItem('theme', theme);
      }

      setTheme(savedTheme);

      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          const isLight = document.documentElement.getAttribute('data-theme') === 'light';
          setTheme(isLight ? 'dark' : 'light');
        });
      }
    </script>
  </body>
</html>
